# ============================================================
# FINTECPESSOAL — variáveis de ambiente (modelo)
# ============================================================
# Copie este arquivo para `.env` e ajuste os valores.
# NUNCA suba o `.env` real para o repositório.
#
# Gere uma chave secreta com:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

# Chave secreta do Django. Obrigatória e forte em produção.
# Em desenvolvimento pode usar o valor gerado. Se conter caracteres
# especiais (#, espaço), coloque o valor entre aspas.
SECRET_KEY="troque-por-uma-chave-secreta-forte"

# Habilita/desabilita o modo debug (true/false).
DEBUG=true

# Hosts/permissões de acesso separados por vírgula.
ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================================
# BANCO DE DADOS (opcional — PostgreSQL/Supabase)
# ============================================================
# Se vazio, o app usa o SQLite local (db.sqlite3). Para usar o PostgreSQL
# (ex.: Supabase), defina a connection string abaixo. Em produção defina-a
# como variável de ambiente do host, e NÃO no .env.
#
# No Supabase use a "Session pooler" connection string. IMPORTANTE: caracteres
# especiais na senha precisam de URL-encoding — '@' vira %40 e '#' vira %23.
#
# Exemplo:
# DATABASE_URL=postgresql://postgres.usuarioprojeto:senha@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=

# ============================================================
# IA OPCIONAL (Google Gemini Flash Lite)
# ============================================================
# Preencha apenas se quiser ativar os recursos de IA (leitura automática de
# comprovantes e sugestão de categoria). Se vazia, o sistema usa o fluxo
# manual normalmente (feature flag opcional — nada quebra).
# Obtenha uma chave gratuita em: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelo usado (padrão: gemini-3.5-flash-lite — plano gratuito).
GEMINI_MODEL=gemini-3.5-flash-lite

